{
    "name": "distribu-tip",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "description": "",
    "license": "ISC",
    "author": "",
    "private": true,
    "type": "commonjs",
    "scripts": {
        "start": "expo start",
        "test:tooling": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects tooling",
        "test:app": "jest --ignoreProjects tooling",
        "test": "npm run test:tooling; tooling=$?; npm run test:app && exit $tooling",
        "typecheck": "node node_modules/@typescript/native/bin/tsc --version && node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit && node node_modules/@typescript/native/bin/tsc -p tsconfig.core.json --noEmit",
        "lint": "eslint .",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "format:fix": "prettier . --write",
        "format:check": "prettier . --check",
        "prepare": "husky || true"
    },
    "dependencies": {
        "expo": "^58.0.17",
        "expo-constants": "~58.0.12",
        "expo-font": "~58.0.8",
        "expo-linking": "~58.0.14",
        "expo-router": "~58.0.25",
        "expo-splash-screen": "~58.0.11",
        "expo-status-bar": "~58.0.4",
        "expo-system-ui": "~58.0.6",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.0",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-screens": "~4.30.0",
        "react-native-worklets": "0.13.0"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.26.0",
        "@eslint/js": "^10.0.1",
        "@jest/globals": "^30.0.0",
        "@testing-library/react-native": "^14.1.0",
        "@types/node": "^26.6.2",
        "@types/react": "~19.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.11.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.2.0",
        "eslint-plugin-expo": "^1.1.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-testing-library": "^7.16.2",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jest-expo": "~58.0.12",
        "jiti": "^2.7.0",
        "lint-staged": "^16.4.0",
        "prettier": "3.9.9",
        "test-renderer": "^1.3.1",
        "ts-jest": "^29.4.13",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "!(*.{js,mjs,cjs,ts,mts,cts,jsx,tsx})": "prettier --write --ignore-unknown"
    },
    "allowScripts": {
        "@parcel/watcher": false,
        "unrs-resolver": false
    }
}
