{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "noEmit": true
  },
  "include": ["src"]
}
