{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "paths": {
            "*": ["./*"],
            "@/*": ["./src/*"]
        },
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        "types": ["node"],
        "esModuleInterop": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noEmit": true,
        "allowUnreachableCode": false
    },
    "include": [
        "src/**/*",
        "__tests__/**/*",
        "eslint.config.mts",
        "types/**/*",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ]
}
